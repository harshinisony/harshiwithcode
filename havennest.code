<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>HavenNest Resort Reviews</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{
    background:#e6e4e4;
    font-family: "Poppins", sans-serif;
    padding:40px 15px;
    color:#0c01010e;
}

/* Main Widget */
.review-widget-container{
    max-width:950px;
    margin:auto;
    display:flex;
    gap:0;
    border-radius:24px;
    overflow:hidden;
    background:rgba(255,255,255,0.75);
    backdrop-filter: blur(12px);
    box-shadow:
        0 10px 30px rgba(0,0,0,0.08),
        0 2px 10px rgba(0,0,0,0.05);
    border:1px solid rgba(255,255,255,0.4);
}

/* Left Summary */
.rating-summary-box{
    flex:1;
    padding:45px 35px;
    background:linear-gradient(135deg,#0f172a,#1e3a5f);
    color:#fff;
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;
    text-align:center;
}

.property-title{
    font-size:30px;
    font-weight:700;
    margin-bottom:8px;
}

.location-text{
    color:#cbd5e1;
    margin-bottom:25px;
    font-size:14px;
}

.score-display{
    display:flex;
    align-items:flex-end;
    gap:6px;
    margin-bottom:8px;
}

.big-score{
    font-size:72px;
    font-weight:800;
    line-height:1;
}

.max-score{
    font-size:22px;
    color:#cbd5e1;
    margin-bottom:10px;
}

.stars-row{
    color:#fbbf24;
    font-size:24px;
    letter-spacing:3px;
    margin-bottom:15px;
}

.total-reviews-count{
    font-size:14px;
    color:#cbd5e1;
    margin-bottom:30px;
    line-height:1.6;
}


*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

html{
    scroll-behavior:smooth;
}

body{
    font-family:'Poppins',sans-serif;
    background:#eeeaea;
    color:#060217;
}

/* Navbar */
nav{
    position:fixed;
    top:0;
    width:100%;
    z-index:1000;
    padding:18px 8%;
    display:flex;
    justify-content:space-between;
    align-items:center;
    background:rgba(15,23,42,0.75);
    backdrop-filter:blur(12px);
}

.logo{
    color:#ffffff;
    font-size:28px;
    font-weight:700;
}

.logo span{
    color:#fbbf24;
}

nav ul{
    display:flex;
    list-style:none;
    gap:28px;
}

nav ul li a{
    color:#ffffff;
    text-decoration:none;
    font-size:15px;
    transition:0.3s ease;
}

nav ul li a:hover{
    color:#fbbf24;
}

/* Hero Section */
.hero{
    height:100vh;
    background:
    linear-gradient(rgba(0,0,0,0.45), rgba(0,0,0,0.55)),
    url('https://images.unsplash.com/photo-1507525428034-b723cf961d3e') no-repeat center center/cover;

    display:flex;
    justify-content:center;
    align-items:center;
    text-align:center;
    padding:20px;
}

.hero-content{
    max-width:850px;
    background:rgba(255,255,255,0.08);
    padding:55px 45px;
    border-radius:28px;
    backdrop-filter:blur(12px);
    border:1px solid rgba(255,255,255,0.12);
}

.hero-tag{
    display:inline-block;
    padding:10px 18px;
    background:rgba(255,255,255,0.12);
    border-radius:999px;
    color:#ffffff;
    margin-bottom:24px;
    font-size:14px;
}

.hero h1{
    color:#ffffff;
    font-size:72px;
    line-height:1.1;
    margin-bottom:20px;
}

.hero h1 span{
    color:#fbbf24;
}

.hero p{
    color:rgba(255,255,255,0.9);
    font-size:18px;
    line-height:1.8;
    margin-bottom:35px;
}

.hero-buttons{
    display:flex;
    justify-content:center;
    gap:18px;
    flex-wrap:wrap;
}

.btn{
    padding:16px 34px;
    border:none;
    border-radius:999px;
    background:linear-gradient(135deg,#fbbf24,#f59e0b);
    color:#0f172a;
    text-decoration:none;
    font-weight:700;
    transition:0.3s ease;
}

.btn:hover{
    transform:translateY(-4px);
}

.btn-outline{
    background:transparent;
    color:#ffffff;
    border:1px solid rgba(255,255,255,0.35);
}

/* Section */
.section{
    padding:90px 8%;
}

.section-title{
    text-align:center;
    margin-bottom:50px;
}

.section-title h2{
    font-size:42px;
    margin-bottom:14px;
}

.section-title p{
    color:#64748b;
}

/* Resort Cards */
.resorts{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(300px,1fr));
    gap:28px;
}

.resort-card{
    background:#ffffff;
    border-radius:24px;
    overflow:hidden;
    box-shadow:0 10px 25px rgba(0,0,0,0.08);
    transition:0.4s ease;
}

.resort-card:hover{
    transform:translateY(-8px);
}

.resort-card img{
    width:100%;
    height:240px;
    object-fit:cover;
}

.resort-content{
    padding:24px;
}

.resort-content h3{
    margin-bottom:10px;
}

.resort-content p{
    color:#64748b;
    line-height:1.7;
    margin-bottom:20px;
}

.price{
    font-size:22px;
    color:#0284c7;
    font-weight:700;
    margin-bottom:18px;
}

/* Booking Form */
.booking-form{
    max-width:850px;
    margin:auto;
    background:linear-gradient(135deg,#0f172a,#1e3a5f);
    padding:50px;
    border-radius:28px;
    color:#ffffff;
}

.form-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:20px;
}

.booking-form input,
.booking-form select{
    width:100%;
    padding:16px;
    border:none;
    border-radius:14px;
    background:rgba(255,255,255,0.1);
    color:#ffffff;
    outline:none;
}

.booking-form input::placeholder{
    color:rgba(255,255,255,0.6);
}

.booking-form button{
    width:100%;
    margin-top:20px;
    padding:16px;
    border:none;
    border-radius:999px;
    background:linear-gradient(135deg,#06b6d4,#0284c7);
    color:#ffffff;
    font-size:16px;
    font-weight:600;
    cursor:pointer;
}

/* Gallery */
.gallery{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(280px,1fr));
    gap:22px;
}

.gallery-item{
    overflow:hidden;
    border-radius:24px;
}

.gallery img{
    width:100%;
    height:260px;
    object-fit:cover;
    transition:0.4s ease;
}

.gallery img:hover{
    transform:scale(1.08);
}

/* Reviews */
.review-grid{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(300px,1fr));
    gap:24px;
}

.review-card{
    background:#ffffff;
    padding:28px;
    border-radius:22px;
    box-shadow:0 8px 20px rgba(0,0,0,0.06);
}

.review-card h4{
    margin-bottom:10px;
}

.review-stars{
    color:#f59e0b;
    margin-bottom:14px;
}

.review-card p{
    color:#64748b;
    line-height:1.8;
}

/* Contact */
.contact-container{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:40px;
}

.contact-info h2{
    font-size:42px;
    margin-bottom:20px;
}

.contact-info p{
    color:#64748b;
    line-height:1.8;
    margin-bottom:20px;
}

.contact-form{
    background:#ffffff;
    padding:40px;
    border-radius:24px;
    box-shadow:0 8px 20px rgba(0,0,0,0.06);
}

.contact-form input,
.contact-form textarea{
    width:100%;
    padding:16px;
    margin-bottom:18px;
    border-radius:14px;
    border:1px solid #e2e8f0;
    background:#f8fafc;
}

.contact-form button{
    width:100%;
    padding:16px;
    border:none;
    border-radius:999px;
    background:linear-gradient(135deg,#0284c7,#06b6d4);
    color:#ffffff;
    font-size:16px;
    font-weight:600;
}

/* Footer */
footer{
    background:#0f172a;
    color:#ffffff;
    text-align:center;
    padding:40px 20px;
}

footer p{
    color:#cbd5e1;
    margin-top:10px;
}

/* Responsive */
@media(max-width:900px){

    nav{
        flex-direction:column;
        gap:15px;
    }

    .hero h1{
        font-size:50px;
    }

    .form-grid,
    .contact-container{
        grid-template-columns:1fr;
    }
}

@media(max-width:600px){

    .hero-content{
        padding:35px 22px;
    }

    .hero h1{
        font-size:40px;
    }

    .hero p{
        font-size:16px;
    }

    .hero-buttons{
        flex-direction:column;
    }

    .btn{
        width:100%;
    }

    .section-title h2,
    .contact-info h2{
        font-size:32px;
    }
}

</style>
</head>
<body>

<!-- Navbar -->
<nav>
<div class="logo">
        <img src="/images/logo.jpeg" alt="" style="width: 50px; height: 50px; border-radius: 50%; margin-right: 10px;">
        Haven<span>Nest</span>
    </div>

    <ul>
        <li><a href="#home">Home</a></li>
        <li><a href="#resorts">Resorts</a></li>
        <li><a href="#booking">Booking</a></li>
        <li><a href="#gallery">Gallery</a></li>
        <li><a href="#contact">Contact</a></li>
        <li><a href="#reviews">Reviews</a></li>
    </ul>
</nav>

<!-- Hero -->
<section class="hero" id="home">

    <div class="hero-content">

        <span class="hero-tag">
            Luxury Resort Experience
        </span>

        <h1>
            Escape To <span>Paradise</span>
        </h1>

        <p>
            Discover tropical luxury resorts, beachside villas,
            peaceful nature stays, and unforgettable vacation experiences.
        </p>

        <div class="hero-buttons">
            <a href="#booking" class="btn">Book Your Stay</a>
            <a href="#gallery" class="btn btn-outline">Explore Gallery</a>
        </div>

    </div>

</section>

<!-- Resorts -->
<section class="section" id="resorts">

    <div class="section-title">
        <h2>Luxury Resorts</h2>
        <p>Choose your perfect getaway destination</p>
    </div>

    <div class="resorts">

        <div class="resort-card">
            <img src="https://images.unsplash.com/photo-1566073771259-6a8506099945">

            <div class="resort-content">
                <h3>Beach Paradise Resort</h3>
                <p>
                    Luxury beachfront villas with infinity pools and ocean views.
                </p>
                <div class="price">₹14,999 / Night</div>
                <a href="#booking" class="btn">Book Now</a>
            </div>
        </div>

        <div class="resort-card">
            <img src="https://images.unsplash.com/photo-1522708323590-d24dbb6b0267">

            <div class="resort-content">
                <h3>Mountain Escape Retreat</h3>
                <p>
                    Peaceful luxury retreat surrounded by nature and waterfalls.
                </p>
                <div class="price">₹11,499 / Night</div>
                <a href="#booking" class="btn">Book Now</a>
            </div>
        </div>

        <div class="resort-card">
            <img src="https://images.unsplash.com/photo-1505693416388-ac5ce068fe85">

            <div class="resort-content">
                <h3>Tropical Lagoon Villas</h3>
                <p>
                    Elegant tropical villas with premium hospitality services.
                </p>
                <div class="price">₹18,999 / Night</div>
                <a href="#booking" class="btn">Book Now</a>
            </div>
        </div>

    </div>

</section>

<!-- Booking -->
<section class="section" id="booking">

    <div class="section-title">
        <h2>Book Your Stay</h2>
        <p>Reserve your dream resort vacation today</p>
    </div>

    <form class="booking-form">

        <div class="form-grid">

            <input type="text" placeholder="Full Name">

            <input type="email" placeholder="Email Address">

            <input type="date">

            <input type="date">

            <select>
                <option>Select Guests</option>
                <option>1 Guest</option>
                <option>2 Guests</option>
                <option>4 Guests</option>
            </select>

            <select>
                <option>Select Room Type</option>
                <option>Luxury Villa</option>
                <option>Beach Suite</option>
                <option>Family Room</option>
            </select>

        </div>

        <button type="submit">Confirm Booking</button>

    </form>

</section>

<!-- Gallery -->
<section class="section" id="gallery">

    <div class="section-title">
        <h2>Resort Gallery</h2>
        <p>Experience the beauty of HavenNest Resorts</p>
    </div>

    <div class="gallery">

        <div class="gallery-item">
            <img src="https://images.unsplash.com/photo-1506744038136-46273834b3fb">
        </div>

        <div class="gallery-item">
            <img src="https://images.unsplash.com/photo-1522708323590-d24dbb6b0267">
        </div>

        <div class="gallery-item">
            <img src="https://images.unsplash.com/photo-1499793983690-e29da59ef1c2">
        </div>

        <div class="gallery-item">
            <img src="https://images.unsplash.com/photo-1519046904884-53103b34b206">
        </div>

    </div>

</section>



<!-- Contact -->
<section class="section" id="contact">

    <div class="contact-container">

        <div class="contact-info">
            <h2>Contact HavenNest</h2>

            <p>
                Have questions about resort bookings, luxury stays,
                or special packages? Contact our support team today.
            </p>

            <p>📍 Mangalore, Karnataka</p>
            <p>📞 +91 98765 43210</p>
            <p>✉️ support@havennest.com</p>
        </div>

        <div class="contact-form">

            <input type="text" placeholder="Your Name">
            <input type="email" placeholder="Your Email">
            <textarea rows="6" placeholder="Your Message"></textarea>

            <button>Send Message</button>

        </div>

    </div>

</section>

<!-- Footer -->
<footer>

    <h2>HavenNest Resorts</h2>

    <p>
        © 2026 HavenNest Resorts Booking Website. All Rights Reserved.
    </p>

</footer>

<style>


/* Booking Button */
.widget-booking-btn{
    display:inline-block;
    padding:14px 30px;
    border-radius:999px;
    background:linear-gradient(135deg,#06b6d4,#0284c7);
    color:#fff;
    text-decoration:none;
    font-weight:600;
    transition:0.3s ease;
    box-shadow:0 5px 15px rgba(14,165,233,0.35);
}

.widget-booking-btn:hover{
    transform:translateY(-3px);
    box-shadow:0 10px 20px rgba(14,165,233,0.45);
}

/* Reviews Section */
.individual-reviews-list{
    flex:1.4;
    padding:35px;
    background:#ffffff;
    display:flex;
    flex-direction:column;
    gap:22px;
}

.review-card-item{
    padding:20px;
    border-radius:18px;
    background:#f8fafc;
    transition:0.3s ease;
    border:1px solid #edf2f7;
}

.review-card-item:hover{
    transform:translateY(-4px);
    box-shadow:0 8px 18px rgba(0,0,0,0.06);
}

/* Header */
.review-card-header{
    display:flex;
    align-items:center;
    gap:14px;
    margin-bottom:12px;
}

.guest-avatar-icon{
    width:50px;
    height:50px;
    border-radius:50%;
    background:linear-gradient(135deg,#0284c7,#06b6d4);
    display:flex;
    align-items:center;
    justify-content:center;
    color:#fff;
    font-size:22px;
    font-weight:bold;
}

.guest-name{
    font-size:16px;
    color:#0f172a;
    margin-bottom:3px;
}

.verified-stay-badge{
    background:#dcfce7;
    color:#15803d;
    font-size:11px;
    padding:4px 8px;
    border-radius:999px;
    margin-left:8px;
    font-weight:600;
}

.card-stars{
    color:#f59e0b;
    font-size:14px;
    letter-spacing:2px;
}

.review-comment-text{
    color:#475569;
    font-size:14px;
    line-height:1.7;
    font-style:italic;
}

/* Mobile Responsive */
@media(max-width:768px){

    .review-widget-container{
        flex-direction:column;
    }

    .rating-summary-box{
        padding:35px 25px;
    }

    .individual-reviews-list{
        padding:25px;
    }

    .big-score{
        font-size:60px;
    }
}
</style>

   <div class="review-widget-container">

    <div class="rating-summary-box">

        <h2 class="property-title">The Nest Resort</h2>

        <p class="location-text">
            Mangalore, Karnataka
        </p>

        <div class="score-display">
            <span class="big-score">4.9</span>
            <span class="max-score">/5</span>
        </div>

        <div class="stars-row">
            ★★★★★
        </div>

        <p class="total-reviews-count">
            Based on 164 verified guest reviews
        </p>

        <a href="https://www.thenestvacation.com/"
           target="_blank"
           class="widget-booking-btn">
           Book Your Stay
        </a>

    </div>
    </div>

    <!-- Right Reviews -->
    <div class="individual-reviews-list">

    </div>

</div>
<!-- Reviews -->
<section class="section">

    <div class="section-title">
        <h2>Guest Reviews</h2>
        <p>What our guests say about their experience</p>
    </div>

    <div class="review-grid">

        <div class="review-card">
            <h4>Priya Sharma</h4>
            <div class="review-stars">★★★★★</div>
            <p>
                Amazing luxury experience with breathtaking beach views and excellent hospitality.
            </p>
        </div>

        <div class="review-card">
            <h4>Rohan Das</h4>
            <div class="review-stars">★★★★★</div>
            <p>
                Perfect family vacation destination with premium rooms and relaxing ambience.
            </p>
        </div>

        <div class="review-card">
            <h4>Sarah Wilson</h4>
            <div class="review-stars">★★★★★</div>
            <p>
                One of the best tropical resort experiences with exceptional service.
            </p>
        </div>

    </div>

</section>
</body>
</html>


